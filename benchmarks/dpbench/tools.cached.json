{
  "tools": [
    {
      "name": "docmill",
      "command": [
        "bin/docmill-bench",
        "{{input}}"
      ],
      "output_mode": "stdout",
      "timeout_seconds": 120
    },
    {
      "name": "docling",
      "command": [
        "benchmarks/dpbench/replay_cache.sh",
        "docling",
        "{{input}}",
        "{{output}}"
      ],
      "output_mode": "file",
      "timeout_seconds": 60
    },
    {
      "name": "opendataloader",
      "command": [
        "benchmarks/dpbench/replay_cache.sh",
        "opendataloader",
        "{{input}}",
        "{{output}}"
      ],
      "output_mode": "file",
      "timeout_seconds": 60
    },
    {
