{
  "tools": [
    { "name": "docmill", "command": ["bin/docmill-bench", "convert", "{{input}}"], "output_mode": "stdout", "timeout_seconds": 120 },
    { "name": "docmill-learned-layout", "command": ["bin/docmill-bench", "convert", "-learned-layout", "{{input}}"], "output_mode": "stdout", "timeout_seconds": 120 },
    { "name": "docmill-learned-columns", "command": ["bin/docmill-bench", "convert", "-learned-columns", "{{input}}"], "output_mode": "stdout", "timeout_seconds": 120 },
    { "name": "docmill-region-markdown", "command": ["bin/docmill-bench", "convert", "-region-markdown", "{{input}}"], "output_mode": "stdout", "timeout_seconds": 120 }
  ]
}
