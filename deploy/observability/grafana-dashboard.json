{
  "__inputs": [
    {
      "name": "DS_VICTORIAMETRICS",
      "label": "VictoriaMetrics",
      "description": "Prometheus-compatible datasource pointing at VictoriaMetrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "docmill — performance",
  "uid": "docmill-perf",
  "tags": ["docmill"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_VICTORIAMETRICS",
        "label": "VictoriaMetrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Pipeline stages (Go)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Avg time per stage",
      "description": "sum_over_time(_sum)/sum_over_time(_count) per stage. Shows where pipeline time goes.",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum by (stage)(sum_over_time(docmill.stage.duration_sum[$__rate_interval])) / sum by (stage)(sum_over_time(docmill.stage.duration_count[$__rate_interval]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 time per stage",
      "description": "histogram_quantile(0.95) over the explicit-bucket stage histogram.",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "histogram_quantile(0.95, sum by (stage, le)(sum_over_time(docmill.stage.duration_bucket[$__rate_interval])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Total time share by stage",
      "description": "Sum of stage time over the selected range — which stage costs the most overall.",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "id": 4,
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum by (stage)(sum_over_time(docmill.stage.duration_sum[$__range]))",
          "legendFormat": "{{stage}}",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Avg convert time / document",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 9 },
      "id": 5,
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum(sum_over_time(docmill.convert.duration_sum[$__range])) / sum(sum_over_time(docmill.convert.duration_count[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pages processed (range)",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 9 },
      "id": 6,
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum(sum_over_time(docmill.pages.processed[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Avg text cells / page",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 13 },
      "id": 7,
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum(sum_over_time(docmill.page.textcells_sum[$__range])) / sum(sum_over_time(docmill.page.textcells_count[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tables detected (range)",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 13 },
      "id": 8,
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum(sum_over_time(docmill.tables.detected[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Text extraction (PDFium) — backend comparison",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 9,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Text extraction avg by backend",
      "description": "Dominant cost. Structured-text extraction latency per page.",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 10,
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum by (backend)(sum_over_time(pdfium.text_cells.duration_sum[$__rate_interval])) / sum by (backend)(sum_over_time(pdfium.text_cells.duration_count[$__rate_interval]))",
          "legendFormat": "{{backend}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Text extraction p95 by backend",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 11,
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "histogram_quantile(0.95, sum by (backend, le)(sum_over_time(pdfium.text_cells.duration_bucket[$__rate_interval])))",
          "legendFormat": "{{backend}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Avg PDF open time by backend",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 26 },
      "id": 12,
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "orientation": "horizontal" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum by (backend)(sum_over_time(pdfium.open.duration_sum[$__range])) / sum by (backend)(sum_over_time(pdfium.open.duration_count[$__range]))",
          "legendFormat": "{{backend}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Avg text cells extracted per page by backend",
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 26 },
      "id": 13,
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
          "expr": "sum by (backend)(sum_over_time(pdfium.text_cells.count_sum[$__rate_interval])) / sum by (backend)(sum_over_time(pdfium.text_cells.count_count[$__rate_interval]))",
          "legendFormat": "{{backend}}"
        }
      ]
    }
  ]
}
